{
  "id": "api_request",
  "name": "API请求测试",
  "description": "发送 HTTP 请求测试 API 接口",
  "category": "实用工具",
  "enabled": true,
  "builtin": true,
  "hidden": true,
  "type": "function",
  "tool_definition": {
    "type": "function",
    "function": {
      "name": "api_request",
      "description": "发送 HTTP 请求以测试或调用 API 接口。支持 GET/POST/PUT/PATCH/DELETE/HEAD/OPTIONS。可自定义请求头、请求体。返回状态码、响应头、响应体、延迟时间。响应体自动尝试 JSON 解析。",
      "parameters": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "description": "HTTP 方法，默认 GET",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
          },
          "url": {
            "type": "string",
            "description": "请求的 URL 地址"
          },
          "headers": {
            "type": "object",
            "description": "自定义请求头（JSON 对象），如 {\"Authorization\": \"Bearer xxx\"}",
            "additionalProperties": { "type": "string" }
          },
          "body": {
            "type": "string",
            "description": "请求体字符串（POST/PUT/PATCH 时使用），JSON 字符串默认添加 Content-Type: application/json"
          },
          "timeout": {
            "type": "integer",
            "description": "超时秒数，默认 15"
          }
        },
        "required": ["url"]
      }
    }
  }
}
